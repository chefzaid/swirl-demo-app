{
  "realm": "swirl-demo-app",
  "displayName": "Swirl Demo App",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "roles": {
    "realm": [
      {
        "name": "user-admin",
        "description": "May delete users when the user service requires this role"
      }
    ]
  },
  "clients": [
    {
      "clientId": "swirlapp-web",
      "name": "Swirl Demo App Angular client",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:4200/*",
        "http://web:8080/*"
      ],
      "webOrigins": [
        "http://localhost:4200",
        "http://web:8080"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*##http://web:8080/*"
      },
      "protocolMappers": [
        {
          "name": "swirl-demo-app-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "swirlapp-web",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "swirl-demo-app-smoke",
      "name": "Local API smoke-test client",
      "enabled": true,
      "publicClient": false,
      "secret": "swirl-demo-app-smoke",
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "swirl-demo-app-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "swirlapp-web",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "user",
      "firstName": "Test",
      "lastName": "User",
      "email": "user@example.com",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": ["default-roles-swirl-demo-app", "user-admin"],
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ]
    }
  ]
}
