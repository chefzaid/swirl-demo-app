{
  "name": "swirlapp-web",
  "version": "1.13.0",
  "description": "Swirl Demo App Web",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --port 4200 --proxy-config proxy.conf.json",
    "build": "ng build",
    "build:uat": "ng build --configuration uat",
    "build-prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:coverage": "ng test --watch=false --coverage --coverage-reporters=text --coverage-reporters=lcov",
    "test:ci": "ng test --watch=false --coverage --coverage-reporters=lcov --reporters=default --reporters=junit --output-file=test-results.xml",
    "test:integration": "playwright test e2e/live-cluster.spec.ts",
    "test:e2e": "playwright test e2e/home.spec.ts",
    "test:e2e:install": "playwright install --with-deps chromium firefox webkit",
    "test:e2e:types": "tsc --project e2e/tsconfig.json --noEmit",
    "analyze": "ng build --configuration production --stats-json"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/router": "^22.2.2",
    "angular-oauth2-oidc": "^22.0.2",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "npm@12.0.2",
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
